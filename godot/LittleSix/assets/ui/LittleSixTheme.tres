[gd_resource type="Theme" load_steps=1 format=3 uid="uid://little-six-theme"]

[resource]
default_font_size = 18

# Font colors
Label/colors/font_color = Color(0.960784, 0.960784, 0.941176, 1)  # #F5F5F0 cream
Label/colors/font_disabled_color = Color(0.392157, 0.447059, 0.545098, 1)  # #64748B slate
Label/colors/font_placeholder_color = Color(0.611765, 0.639216, 0.686275, 1)  # #9CA3AF

# Button styles
Button/styles/normal = SubResource("StyleBoxFlat_normal")
Button/styles/hover = SubResource("StyleBoxFlat_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_disabled")
# Button/fonts/font = ExtResource("3")  # TODO: Add Press Start 2P font
Button/font_sizes/font_size = 18
Button/constants/minimum_size = Vector2(0, 56)

# Secondary button style
Button/styles/secondary_normal = SubResource("StyleBoxFlat_secondary_normal")
Button/styles/secondary_hover = SubResource("StyleBoxFlat_secondary_hover")

# Panel styles
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")

# ProgressBar styles
ProgressBar/styles/fill = SubResource("StyleBoxFlat_progress_fill")

